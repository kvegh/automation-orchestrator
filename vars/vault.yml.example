---
# Optional launch-time variables file. Copy outside this repository, fill in values,
# and encrypt with ansible-vault. Supply explicitly with -e @/path/to/target.vault.yml.
# The playbooks do not load vars/vault.yml or choose a target from this repository.
#
# OCP credentials (ocp_api_url, ocp_admin_password) may come from the launch survey
# or the same explicitly selected encrypted launch file.

# AAP integration (omit all three to deploy standalone)
aap_gateway_url: "https://aap.example.com"
aap_admin_username: "your-target-admin"
aap_admin_password: "your-aap-admin-password"
